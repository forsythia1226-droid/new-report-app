# --- Google Sheets ---
# 서비스 계정 키 파일 경로 (기본값: service_account.json)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# 현안을 저장할 스프레드시트 ID (URL 의 /d/<여기>/edit 부분)
ISSUE_SHEET_ID=
# 워크시트(탭) 이름 (기본값: issues)
ISSUE_WORKSHEET_NAME=issues

# --- 보관 정책 ---
RETENTION_HOURS=48

# --- Claude API ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000

# --- (기존 뉴스 리포트 앱용) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 시연용 데모 모드 ---
# true 이면 Google Sheets / Claude API 없이 로컬 JSON 으로 동작합니다.
DEMO_MODE=false
DEMO_DATA_FILE=demo_data.json

# --- 앱 제목 / 조직도 ---
APP_TITLE=[대한전선] 일일현안 보고
ORG_FILE=organization.json
